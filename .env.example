# Copy this file to .env and fill in real values before deploying anywhere
# that matters. .env itself is gitignored — never commit real secrets.
#
# Every variable below is read directly by the framework (grepped for
# `process.env` across packages/core and packages/cli — see
# packages/core/src/session.ts, the only file that reads any of these).

# Sessions are opt-in per app (devora.config.ts's `auth` field: "shared" |
# "isolated" | "none"), not a project-wide requirement — an app with
# `auth: "none"` (e.g. this repo's apps/marketing, which has no login route
# at all) never reads, and never requires, ANY variable below. Forcing every
# app to configure a secret it will never use was the wrong default: a site
# with no login shouldn't have a deploy-time dependency on session config.
# Only an app with `auth: "shared"` or `auth: "isolated"` needs any of this.

# Required in production for a "shared"-auth app; optional in dev.
#
# Signs/verifies the session cookie every "shared"-auth app uses
# (packages/core/src/session.ts). In dev, if unset, the framework falls back
# to a hardcoded, clearly-logged insecure default so local development still
# works — see the "[devora] no DEVORA_SESSION_SECRET set" warning in your
# `devora dev` output if this happens. In production (NODE_ENV=production),
# an unset value throws at startup instead of silently using that fallback.
# Generate one with: openssl rand -base64 32
DEVORA_SESSION_SECRET=

# Optional. Per-app override for any app with `auth: "isolated"` in
# devora.config.ts (e.g. apps/admin) — gives that app's session cookie its
# own signing secret, separate from DEVORA_SESSION_SECRET, so a shared-app
# session cookie is structurally incapable of authenticating against an
# isolated app. Name the variable DEVORA_SESSION_SECRET_<APPNAME> in
# uppercase (this repo's isolated app is "admin", hence the name below). If
# unset, an isolated app falls back to DEVORA_SESSION_SECRET, and from there
# to the same insecure dev-only default if that's unset too. An app with
# `auth: "none"` has no such variable and needs none — see above.
DEVORA_SESSION_SECRET_ADMIN=

# Not read by the framework directly, but affects it: session.ts checks
# NODE_ENV === "production" to (a) require a real DEVORA_SESSION_SECRET
# instead of the dev fallback, and (b) add the `Secure` cookie attribute.
# Set this for any real deployment; adapter-node's `devora start` does not
# set it for you. Vercel/Netlify set this automatically on their platforms.
NODE_ENV=production
