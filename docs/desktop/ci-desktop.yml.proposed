# Proposal only: NOT in .github/workflows. Runs the desktop window check on Windows and Linux.
name: desktop-window
on:
  workflow_dispatch:
jobs:
  window:
    strategy:
      fail-fast: false
      matrix:
        os: [windows-latest, ubuntu-latest]
    runs-on: ${{ matrix.os }}
    steps:
      - uses: actions/checkout@v4
      - uses: pnpm/action-setup@v4
        with:
          version: 9.9.0
      - uses: actions/setup-node@v4
        with:
          node-version: 24
      - uses: dtolnay/rust-toolchain@stable
      - name: Linux packages
        if: runner.os == 'Linux'
        run: sudo apt-get update && sudo apt-get install -y libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev xvfb
      - run: pnpm install --frozen-lockfile
      - run: pnpm run build
      - name: Window check (Linux, under a virtual display)
        if: runner.os == 'Linux'
        run: xvfb-run -a pnpm run check:desktop-window
      - name: Window check (Windows)
        if: runner.os == 'Windows'
        run: pnpm run check:desktop-window
