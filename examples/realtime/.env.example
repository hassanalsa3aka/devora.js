# Shared by the app and the realtime server. Generate each with: openssl rand -base64 32
# Signs the 60-second tokens the browser connects with.
REALTIME_TOKEN_SECRET=
# Lets the app (and only the app) call POST /publish on the realtime server.
REALTIME_PUBLISH_SECRET=
# Where the browser connects, and where the app publishes.
REALTIME_URL=http://localhost:4400
# Required in production for the app's login sessions.
DEVORA_SESSION_SECRET=
