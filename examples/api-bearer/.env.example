# Copy this file to .env and fill in real values before deploying anywhere
# that matters. .env itself is gitignored — never commit real secrets.
#
# Sessions are opt-in per app (devora.config.ts's `auth` field). An app
# with `auth: "none"` needs none of the variables below at all.

# Required in production for any "shared"-auth app; optional in dev — an
# insecure dev-only fallback is used instead, with a warning.
# Generate one with: openssl rand -base64 32
DEVORA_SESSION_SECRET=

# Per-app override for any app with auth: "isolated" — name the variable
# DEVORA_SESSION_SECRET_<APPNAME> in uppercase.

NODE_ENV=production
