{
  "name": "devora-monorepo",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx packages/cli/src/index.ts dev",
    "build": "tsx packages/cli/src/index.ts build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "check:docs": "node scripts/checkMarkdownLinks.mjs && node scripts/checkVersions.mjs && node scripts/docsSiteUrl.mjs --check",
    "compare:dev-parity": "node scripts/dev-server-compare/parity.mjs",
    "compare:build-parity": "tsx scripts/dev-server-compare/build-parity.mts",
    "check:no-vite": "node scripts/check-no-vite.mjs",
    "measure:build": "node scripts/measure-build.mjs",
    "compare:dev-security": "node scripts/dev-server-compare/attack-compare.mjs",
    "compare:built-security": "node scripts/dev-server-compare/built-attack.mjs",
    "check:dev-browser": "node scripts/dev-server-compare/browser-checks.mjs",
    "measure:dev-reexec": "node scripts/dev-server-compare/reexec.mjs",
    "measure:dev-perf": "node scripts/dev-server-compare/perf.mjs",
    "fuzz:dev-server": "tsx scripts/dev-server-compare/fuzz.mts",
    "check:desktop-window": "node scripts/desktop-check.mjs"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "adapters/*",
    "create-devora"
  ],
  "dependencies": {
    "@devorajs/core": "*"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "@devorajs/cli": "*",
    "vitest": "^2.1.0",
    "playwright-core": "^1.49.0"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.2",
      "source-map-js": "^1.2.2"
    }
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "source-map-js": "^1.2.2"
  },
  "resolutions": {
    "esbuild": "^0.28.2",
    "source-map-js": "^1.2.2"
  }
}
