node_modules/
dist/
.vercel/
.netlify/
netlify/
*.tsbuildinfo
# `netlify.toml` is deliberately NOT listed here (unlike `netlify/` and
# `.netlify/` above) — it's a static, per-app config file committed ahead of
# time (see apps/*/netlify.toml), the same role `vercel.json` already plays
# and for the same reason: Netlify reads its config before running any build
# command, so a config that only appeared as build output was always too
# late to matter — a real bug found via an actual live Netlify deploy, see
# ROADMAP.md #4.
.turbo/
nginx.conf
Caddyfile

# Real bug found via an actual Vercel deploy (not locally reproducible: needs
# a single-pass CI install, not a dev machine where `pnpm install` gets run
# more than once): packages/cli/dist/index.js is built by a `prepare` script
# during `pnpm install`, but pnpm links bins into node_modules/.bin BEFORE
# `prepare` finishes on a one-shot install — ENOENT on the very first
# install anywhere that isn't run twice. Committing the built file removes
# the race entirely (the bin target already exists from git; `prepare` just
# refreshes it moments later, same path, no relink needed). Re-run
# `pnpm --filter @devora/cli build` and commit the result after editing
# anything under packages/cli/src.
!packages/cli/dist/
!packages/cli/dist/index.js

# Real secrets — never commit. .env.example (the template) is intentionally
# NOT ignored by this pattern.
.env
.env.*
!.env.example

# macOS
.DS_Store
